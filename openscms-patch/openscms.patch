+/// Allowed PSIDs per device type, from a comma separated list of decimal or 0x-hex values.
+fn allowed_psids_for(device_type: &DeviceType) -> Option<Vec<u64>> {
+    let var = match device_type {
+        DeviceType::Obu => "RA_PSID_POLICY_OBU",
+        DeviceType::Rsu => "RA_PSID_POLICY_RSU",
+    };
+    let raw = std::env::var(var).ok()?;
+    let list = raw
+        .split(',')
+        .map(|s| s.trim())
+        .filter(|s| !s.is_empty())
+        .filter_map(|s| {
+            if let Some(hex) = s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")) {
+                u64::from_str_radix(hex, 16).ok()
+            } else {
+                s.parse::<u64>().ok()
+            }
+        })
+        .collect::<Vec<u64>>();
+    Some(list)
+}
+
+fn check_psid_policy(
+    device_type: &DeviceType,
+    requested: &[u64],
+) -> Result<(), errors::HandleResponseError> {
+    let Some(allowed) = allowed_psids_for(device_type) else {
+        return Ok(());
+    };
+    if requested.is_empty() {
+        log::warn!("No appPermissions requested by {:?}", device_type);
+        return Err(errors::HandleResponseError::new(
+            "Disallowed appPermissions: none requested",
+            StatusCode::BAD_REQUEST,
+            Ieee1609Dot2Dot1ErrorCodes::BadRequest(
+                errors::BadRequestErrorCodes::DisallowedAppPermissions,
+            ),
+        ));
+    }
+    if let Some(bad) = requested.iter().find(|p| !allowed.contains(p)) {
+        log::warn!(
+            "PSID {:#x} is not allowed for {:?} (allowed: {:?})",
+            bad,
+            device_type,
+            allowed
+        );
+        return Err(errors::HandleResponseError::new(
+            &format!("Disallowed appPermissions: PSID {:#x}", bad),
+            StatusCode::BAD_REQUEST,
+            Ieee1609Dot2Dot1ErrorCodes::BadRequest(
+                errors::BadRequestErrorCodes::DisallowedAppPermissions,
+            ),
+        ));
+    }
+    Ok(())
+}
